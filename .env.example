# Copy to .env and fill in your keys. Never commit .env.
# Provider used by dsh (see dsh-home/settings.yaml llm-pi-ai section).
# The credentials store (~/.dsh/.credentials.yaml) takes precedence when both
# are set; the env value is the fallback and the config-driven path.
COMMAND_CODE_API_KEY=

# DeepSeek's own provider key (used by the web-search plugin and the
# deepseek-official route if configured).
DEEPSEEK_API_KEY=

# Efficiency knobs (defaults shown):
DSH_MAX_PARALLEL_TOOL_CALLS=16
DSH_BASH_TIMEOUT_MS=600000

# Host workspace mounted at /workspace (default: ./workspace)
WORKSPACE_DIR=./workspace
